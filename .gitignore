# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
myvenv/
*.egg-info/
eco_review_dev.db

# --- ML model artifacts (trained on this deployment's own data --
# never committed, see app/ml/model_store.py) ---
backend/app/ml/artifacts/*
!backend/app/ml/artifacts/.gitkeep

# --- Uploaded/stored documents (may contain RESTRICTED data) ---
backend/storage/

# --- Env files (never commit real secrets/keys) ---
backend/.env
frontend/.env
.env

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/

# --- OS / editor ---
.DS_Store
.vscode/*
!.vscode/extensions.json
*.swp
